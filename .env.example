# ContextShield Configuration
PORT=8080
HOST=127.0.0.1
UPSTREAM_URL=https://api.openai.com
# OPENAI_API_KEY=sk-...

# Security & Redaction: 'redact' | 'block' | 'off'
REDACT_MODE=redact

# Rate Limiting & Token Budgets (0 = disabled)
RATE_LIMIT_PER_MINUTE=120
SESSION_TOKEN_BUDGET=250000
DAILY_TOKEN_BUDGET=1000000

# Cost Estimation per 1,000 tokens (USD)
COST_PER_1K_PROMPT_TOKENS=0.005
COST_PER_1K_COMPLETION_TOKENS=0.015
